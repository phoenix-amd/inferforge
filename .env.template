# InferForge Configuration
# Copy to .env and fill in your values

# --- Claude API ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- AMD Gateway (alternative to Anthropic direct) ---
# AMD_GATEWAY_KEY=

# --- Server ---
INFERFORGE_HOST=0.0.0.0
INFERFORGE_PORT=7801

# --- Auth (optional) ---
# INFERFORGE_AUTH_USER=admin
# INFERFORGE_AUTH_PASS=
# INFERFORGE_JWT_SECRET=

# --- Hyperloom ---
# HYPERLOOM_KB_URL=http://127.0.0.1:20000
# HYPERLOOM_KB_TOKEN=
# HYPERLOOM_INSTALL_DIR=

# --- Database ---
# INFERFORGE_DB_PATH=inferforge.db
